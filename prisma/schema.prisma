generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model Booking {
  id             String        @id
  userId         String
  vehicleId      String
  pickupLocation String
  returnLocation String
  pickupAt       DateTime
  returnAt       DateTime
  totalPrice     Int
  status         BookingStatus @default(PENDING)
  paymentStatus  PaymentStatus @default(PENDING)
  createdAt      DateTime      @default(now())
  updatedAt      DateTime
  User           User          @relation(fields: [userId], references: [id])
  Vehicle        Vehicle       @relation(fields: [vehicleId], references: [id])
  Feedback       Feedback[]
  Payment        Payment?
}

model Feedback {
  id        String         @id
  userId    String
  bookingId String?
  rating    Int
  comment   String?
  status    FeedbackStatus @default(PENDING)
  createdAt DateTime       @default(now())
  updatedAt DateTime
  Booking   Booking?       @relation(fields: [bookingId], references: [id])
  User      User           @relation(fields: [userId], references: [id])
}

model Payment {
  id                String        @id
  bookingId         String?       @unique
  userId            String
  provider          String
  providerPaymentId String?
  amount            Int
  currency          String        @default("KES")
  status            PaymentStatus @default(PENDING)
  rawResponse       Json?
  createdAt         DateTime      @default(now())
  Booking           Booking?      @relation(fields: [bookingId], references: [id])
  User              User          @relation(fields: [userId], references: [id])
}

model User {
  id           String     @id
  name         String?
  email        String     @unique
  phone        String?
  passwordHash String
  role         UserRole   @default(USER)
  createdAt    DateTime   @default(now())
  updatedAt    DateTime
  Booking      Booking[]
  Feedback     Feedback[]
  Payment      Payment[]
}

model Vehicle {
  id           String         @id
  title        String
  make         String?
  model        String?
  year         Int?
  category     String?
  seats        Int
  transmission String
  fuelType     String
  location     String
  dailyPrice   Int
  status       VehicleStatus  @default(AVAILABLE)
  createdAt    DateTime       @default(now())
  updatedAt    DateTime
  Booking      Booking[]
  VehicleImage VehicleImage[]
}

model VehicleImage {
  id        String  @id
  vehicleId String
  url       String
  order     Int     @default(0)
  Vehicle   Vehicle @relation(fields: [vehicleId], references: [id])
}

enum BookingStatus {
  PENDING
  CONFIRMED
  CANCELLED
  COMPLETED
}

enum FeedbackStatus {
  PENDING
  APPROVED
  REJECTED
}

enum PaymentStatus {
  PENDING
  PAID
  FAILED
  REFUNDED
}

enum UserRole {
  USER
  ADMIN
}

enum VehicleStatus {
  AVAILABLE
  MAINTENANCE
  UNAVAILABLE
}
