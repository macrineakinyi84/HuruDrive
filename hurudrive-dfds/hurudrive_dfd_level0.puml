@startuml

title HuruDrive Vehicle Rental System – DFD Level 0 (Yourdon/DeMarco)

left to right direction

actor Customer
actor Admin
actor "Payment Gateway" as PG

' Processes
rectangle "1.0 Search & Reservation" as P1
rectangle "2.0 Booking Management" as P2
rectangle "3.0 Payment Processing" as P3
rectangle "4.0 Fleet & Admin" as P4
rectangle "5.0 Reporting" as P5

' Data stores
database "D1 Vehicle Inventory" as D1
database "D2 Booking Records"   as D2
database "D3 Customer Records"  as D3
database "D4 Payment Records"   as D4
database "D5 Reports"           as D5

' External interactions
Customer --> P1 : search criteria\nbooking request
P1 --> Customer : vehicle listings\nbooking summary

P1 --> P2 : tentative booking\nbooking request
P2 --> P1 : booking status

P2 --> P3 : payment required\npayment details
P3 --> P2 : payment result

P3 --> PG : payment authorization\ncharge request
PG --> P3 : authorization result

Admin --> P4 : vehicle updates\npricing changes
P4 --> D1 : update vehicle data
P4 --> P5 : admin report requests

P2 --> D2 : create/update booking
P1 --> D1 : read vehicle availability
P4 --> D1 : update vehicle inventory
P3 --> D4 : record payment
P2 --> D3 : read/write customer info
P5 --> D5 : store reports
P5 --> Admin : reports

@enduml
