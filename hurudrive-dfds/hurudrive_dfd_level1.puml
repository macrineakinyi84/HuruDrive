@startuml
$title HuruDrive Vehicle Rental System – DFD Level 1 (Decomposition of major processes)

left to right direction

actor Customer
actor Admin
actor "Payment Gateway" as PG

' Processes under Search & Reservation (1.0)
rectangle "1.1 Search Vehicles" as P11
rectangle "1.2 Check Availability" as P12
rectangle "1.3 Create Tentative Booking" as P13

' Processes under Booking Management (2.0)
rectangle "2.1 Confirm Booking" as P21
rectangle "2.2 Update Availability" as P22
rectangle "2.3 Notify Customer" as P23

' Processes under Payment Processing (3.0)
rectangle "3.1 Initiate Payment" as P31
rectangle "3.2 External Payment Gateway" as P32
rectangle "3.3 Record Payment" as P33

' Data stores
database "D1 Vehicle Inventory" as D1
database "D2 Booking Records"   as D2
database "D3 Customer Records"  as D3
database "D4 Payment Records"   as D4

' Customer interactions
Customer --> P11 : search criteria
P11 --> P12 : selected vehicle\nsearch results
P12 --> D1 : query availability
D1 --> P12 : availability data
P12 --> P13 : available slot\nreservation request
P13 --> D2 : write tentative booking
P13 --> P31 : payment required

' Booking workflow
P31 --> P32 : payment request
P32 --> PG : forward to gateway
PG --> P32 : authorization/confirmation
P32 --> P33 : payment result
P33 --> D4 : store payment record
P33 --> P21 : payment verified

P21 --> D2 : confirm booking (update)
P21 --> P22 : reserve vehicle
P22 --> D1 : update vehicle status
P21 --> P23 : booking confirmation
P23 --> Customer : confirmation email/SMS

' Admin & Reporting
Admin --> P4 : manage fleet/pricing
P4 --> D1 : update inventory
Admin --> P5 : request reports
P5 --> D2 : read bookings
P5 --> D4 : read payments
P5 --> Admin : generated reports

@enduml