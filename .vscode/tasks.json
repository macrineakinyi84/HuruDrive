{
  "version": "2.0.0",
  "tasks": [
    {
      "label": "🚀 Start Full System (Frontend + Backend)",
      "type": "shell",
      "command": "powershell -ExecutionPolicy Bypass -File ${workspaceFolder}/start-dev.ps1",
      "isBackground": true,
      "problemMatcher": [],
      "presentation": {
        "reveal": "always",
        "panel": "new",
        "focus": false
      },
      "runOptions": {
        "runOn": "default"
      },
      "group": {
        "kind": "build",
        "isDefault": true
      }
    },
    {
      "label": "🔧 Start Backend Server Only",
      "type": "npm",
      "script": "dev:server",
      "problemMatcher": [],
      "presentation": {
        "reveal": "always",
        "panel": "new"
      }
    },
    {
      "label": "⚛️ Start Frontend Only",
      "type": "npm",
      "script": "dev:client",
      "problemMatcher": [],
      "presentation": {
        "reveal": "always",
        "panel": "new"
      }
    },
    {
      "label": "🗄️ Open Prisma Studio (Database)",
      "type": "npm",
      "script": "prisma:studio",
      "problemMatcher": [],
      "presentation": {
        "reveal": "always",
        "panel": "new"
      }
    }
  ]
}
